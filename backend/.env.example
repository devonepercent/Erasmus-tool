# Copy this file to .env (only for running on your own computer).
# On Vercel you paste each of these into Project > Settings > Environment Variables instead.
# Never share these values, never upload a filled in .env to GitHub or Drive.

ANTHROPIC_API_KEY=sk-ant-...             # console.anthropic.com > API Keys
SUPABASE_URL=https://xxxx.supabase.co    # Supabase > Project Settings > API > Project URL
SUPABASE_SERVICE_KEY=eyJ...              # Supabase > Project Settings > API > service_role (the secret one)
GMAIL_USER=hello@onepercentabroad.com    # the Gmail that sends the reports
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   # a Gmail App Password, NOT the normal password
FRONTEND_URL=https://onepercentabroad.com/chance   # the page students open (emails link to it)

# Optional
CLAUDE_MODEL=claude-sonnet-5-5
HIGH_INTENT_PCT=60                       # score at or above this is tagged high_intent
RATE_LIMIT_PER_HOUR=12                   # checks one connection may run per hour
ALLOWED_ORIGINS=*                        # after launch, set to your page address, e.g. https://onepercentabroad.com
